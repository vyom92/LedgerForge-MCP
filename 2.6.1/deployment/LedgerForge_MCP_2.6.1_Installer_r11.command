def sha_bytes(b): return hashlib.sha256(b).hexdigest()
def sha_file(p): return sha_bytes(Path(p).read_bytes())
def run(cmd,timeout=180,cwd=None,env=None,check=True):
    p=subprocess.run([str(x) for x in cmd],cwd=cwd,env=env,capture_output=True,text=True,check=False,timeout=timeout)
    if check and p.returncode!=0: raise RuntimeError('command failed: '+' '.join(map(str,cmd))+'\n'+(p.stdout or '')[-8000:]+'\n'+(p.stderr or '')[-8000:])
    return p

def self_verify():
    p=Path(__file__); s=p.read_text(); import re
    n=re.sub(r'SELF_NORM_SHA = "[0-9a-f]{64}"','SELF_NORM_SHA = "'+'0'*64+'"',s,count=1)
    if sha_bytes(n.encode())!=SELF_NORM_SHA: raise RuntimeError('installer self-integrity mismatch')
    if TARGET_SOURCE_SHA != META['executor']['sha256']: raise RuntimeError('installer target source binding mismatch')

def decode_payloads():
    out={}
    for role,enc in PAYLOADS.items():
        b=zlib.decompress(base64.b85decode(enc.encode())); m=META[role]
        if len(b)!=m['size'] or sha_bytes(b)!=m['sha256']: raise RuntimeError('embedded payload mismatch: '+role)
        out[role]=b
    return out

def paths(root,desktop):
    return {
      'executor':root/'executor_v2_1.py','static_qualifier':root/'qualify_executor_current_static.py','isolated_qualifier':root/'qualify_executor_current_isolated.py','release_qualifier':root/'qualify_release.py','main_launcher':desktop/'LedgerForge MCP.command','owner_admin':root/'ledgerforge_mcp_owner_admin.py','owner_wrapper':desktop/'LedgerForge MCP Owner Recovery.command','owner_version':root/'.mcp-owner-recovery-version','release_activator':root/'ledgerforge_mcp_release_activator.py','release_version':root/'.mcp-release-version','admin_token':root/'.executor-admin-token'}

def atomic_write(p,b,mode):
    p.parent.mkdir(parents=True,exist_ok=True); q=p.with_name(p.name+'.mcp261.tmp'); q.write_bytes(b); os.chmod(q,mode); os.replace(q,p)

def verify_baseline(root,desktop):
    ps=paths(root,desktop)
    checks=[('executor',BASE_SOURCE_SHA),('main_launcher',BASE_LAUNCHER_SHA),('owner_admin',BASE_OWNER_SHA)]
    for role,exp in checks:
        p=ps[role]
        if not p.is_file() or p.is_symlink() or sha_file(p)!=exp: raise RuntimeError(f'baseline mismatch: {role}')
    if not (root/'.venv/bin/python').exists(): raise RuntimeError('production MCP venv missing')

def quiescence(root):
    py=root/'.venv/bin/python'; admin=root/'ledgerforge_mcp_owner_admin.py'
    p=run([py,admin,'status']); st=json.loads(p.stdout)
    lease=st.get('lease') or {}
    bad=[]
    if lease.get('active'): bad.append('active lease')
    if st.get('running_operations'): bad.append('running operations')
    if st.get('running_validations'): bad.append('running validations')
    if st.get('process_records'): bad.append('running generic processes')
    if st.get('incomplete_journals'): bad.append('incomplete journals')
    if bad: raise RuntimeError('cutover not quiescent: '+', '.join(bad))
    return st

def prepare_slot(payloads,root):
    slot=Path(tempfile.mkdtemp(prefix='mcp261-prequal-'))
    for role in ('executor','static_qualifier','isolated_qualifier','release_qualifier'):
        atomic_write(slot/META[role]['filename'],payloads[role],META[role]['mode'])
    py=root/'.venv/bin/python'
    run([py,slot/META['static_qualifier']['filename'],slot/META['executor']['filename']],timeout=180)
    run([py,slot/META['release_qualifier']['filename'],'--prepared-slot',slot],timeout=300)
    run([py,slot/META['isolated_qualifier']['filename'],'--candidate',slot/META['executor']['filename'],'--expected-source-sha',TARGET_SOURCE_SHA],timeout=300)
    return slot

def backup_state(root,desktop):
    ps=paths(root,desktop); stamp=time.strftime('%Y%m%dT%H%M%S'); d=root/'mcp2.6.1-backups'/('2.6.0-'+stamp)
    d.mkdir(parents=True,exist_ok=False); manifest={}
    for role,p in ps.items():
        if p.exists():
            if p.is_symlink() or not p.is_file(): raise RuntimeError('unsafe control path: '+str(p))
            data=p.read_bytes(); name=role+'.bin'; (d/name).write_bytes(data); manifest[role]={'present':True,'file':name,'sha256':sha_bytes(data),'mode':p.stat().st_mode & 0o777}
        else: manifest[role]={'present':False}
    (d/'manifest.json').write_text(json.dumps(manifest,indent=2,sort_keys=True)+'\n'); return d,manifest

def restore(root,desktop,backup,manifest):
    ps=paths(root,desktop)
    for role,p in ps.items():
        m=manifest[role]
        if m['present']:
            b=(backup/m['file']).read_bytes()
            if sha_bytes(b)!=m['sha256']: raise RuntimeError('rollback backup corruption: '+role)
            atomic_write(p,b,m['mode'])
        else:
            try: p.unlink()
            except FileNotFoundError: pass

def install_targets(root,desktop,payloads):
    ps=paths(root,desktop)
    for role,b in payloads.items(): atomic_write(ps[role],b,META[role]['mode'])
    token=ps['admin_token']
    if not token.exists(): atomic_write(token,(secrets.token_urlsafe(48)+'\n').encode(),0o600)
    elif token.is_symlink() or not token.is_file(): raise RuntimeError('unsafe admin token path')
    os.chmod(token,0o600)
    normal=(root/'.executor-token').read_text().strip() if (root/'.executor-token').is_file() else ''
    admin=token.read_text().strip()
    if not admin or admin==normal: raise RuntimeError('admin token identity invalid')
    for role,m in META.items():
        p=ps[role]
        if sha_file(p)!=m['sha256'] or p.stat().st_size!=m['size']: raise RuntimeError('installed target mismatch: '+role)

def port_open(port=8768):
    s=socket.socket(); s.settimeout(.25)
    try: return s.connect_ex(('127.0.0.1',port))==0
    finally: s.close()

def postcheck(root,desktop):
    ps=paths(root,desktop); py=root/'.venv/bin/python'; q=ps['isolated_qualifier']
    if sha_file(ps['executor'])!=TARGET_SOURCE_SHA: raise RuntimeError('postcutover source mismatch')
    run([ps['main_launcher'],'start'],timeout=90)
    deadline=time.time()+20
    while time.time()<deadline and not port_open(): time.sleep(.25)
    if not port_open(): raise RuntimeError('2.6.1 did not listen on 8768')
    run([py,q,'--expected-source-sha',TARGET_SOURCE_SHA,'--schema-only-live'],timeout=180)
    run([py,q,'--expected-source-sha',TARGET_SOURCE_SHA,'--live-smoke'],timeout=180)
    run([py,q,'--expected-source-sha',TARGET_SOURCE_SHA,'--admin-smoke-live'],timeout=180)
    run([py,ps['owner_admin'],'self-test'],timeout=180)

def receipt(root,status,extra):
    d=root/'mcp-releases'; d.mkdir(exist_ok=True); p=d/('2.6.1-deployment-'+time.strftime('%Y%m%dT%H%M%S')+'.json')
    obj={'release':'2.6.1','status':status,'target_source_sha256':TARGET_SOURCE_SHA,'target_launcher_sha256':META['main_launcher']['sha256'],'credential_values_exposed':False,**extra}; p.write_text(json.dumps(obj,indent=2,sort_keys=True)+'\n'); return p

def production(payloads):
    home=Path.home(); root=home/'ledgerforge-mcp-prototype'; desktop=home/'Desktop'; verify_baseline(root,desktop); quiescence(root)
    slot=None; backup=None; manifest=None; stopped=False
    try:
        print('Pre-cutover qualification...'); slot=prepare_slot(payloads,root); verify_baseline(root,desktop); quiescence(root)
        backup,manifest=backup_state(root,desktop)
        print('Stopping MCP 2.6.0...'); run([paths(root,desktop)['main_launcher'],'stop'],timeout=90); stopped=True
        if port_open(): raise RuntimeError('executor still listening after stop')
        install_targets(root,desktop,payloads); postcheck(root,desktop)
        rp=receipt(root,'PASS',{'backup_dir':str(backup),'rollback_performed':False})
        print('MCP 2.6.1 CUTOVER: PASS'); print('receipt='+str(rp)); return 0
    except Exception as exc:
        print('CUTOVER ERROR: '+str(exc),file=sys.stderr)
        if stopped and backup and manifest:
            try:
                restore(root,desktop,backup,manifest)
                old=paths(root,desktop)['main_launcher']; run([old,'stop'],timeout=60,check=False); run([old,'start'],timeout=90)
                if sha_file(paths(root,desktop)['executor'])!=BASE_SOURCE_SHA or sha_file(old)!=BASE_LAUNCHER_SHA: raise RuntimeError('rollback identity mismatch')
                rp=receipt(root,'ROLLED_BACK',{'backup_dir':str(backup),'rollback_performed':True,'error':str(exc)[:2000]}); print('ROLLBACK: PASS'); print('receipt='+str(rp),file=sys.stderr)
            except Exception as rb: print('ROLLBACK FAILURE: '+str(rb),file=sys.stderr)
        return 2
    finally:
        if slot: shutil.rmtree(slot,ignore_errors=True)

def synthetic_transaction(payloads,inject=False):
    td=Path(tempfile.mkdtemp(prefix='mcp261-installer-selftest-')); root=td/'root'; desk=td/'Desktop'; root.mkdir(); desk.mkdir(); ps=paths(root,desk)
    old={}
    for role,p in ps.items():
        if role in ('admin_token',): continue
        b=('OLD-'+role+'\n').encode(); atomic_write(p,b,0o700 if role not in ('owner_version','release_version') else 0o600); old[role]=b
    atomic_write(root/'.executor-token',b'normal-token\n',0o600)
    backup,manifest=backup_state(root,desk)
    try:
        install_targets(root,desk,payloads)
        if inject: raise RuntimeError('injected-post-install-failure')
        for role,m in META.items(): assert sha_file(ps[role])==m['sha256']
        return 'success'
    except RuntimeError:
        if not inject: raise
        restore(root,desk,backup,manifest)
        for role,b in old.items(): assert ps[role].read_bytes()==b
        assert not ps['admin_token'].exists()
        return 'rollback'
    finally: shutil.rmtree(td,ignore_errors=True)

def selftest(payloads):
    assert synthetic_transaction(payloads,False)=='success'; print('synthetic_cutover=PASS')
    assert synthetic_transaction(payloads,True)=='rollback'; print('synthetic_rollback_injection=PASS')
    print('MCP 2.6.1 INSTALLER SELF-TEST: PASS'); return 0

def main():
    self_verify(); payloads=decode_payloads()
    if '--self-test' in sys.argv: return selftest(payloads)
    return production(payloads)
if __name__=='__main__': raise SystemExit(main())
